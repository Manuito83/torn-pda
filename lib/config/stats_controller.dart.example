import 'package:flutter/widgets.dart';
import 'package:torn_pda/models/drawer_section.dart';

class StatsController {
  static bool browserOpen = false;

  static final chat = _ChatStats();

  static final NavigatorObserver rootObserver = NavigatorObserver();
  static final NavigatorObserver homeObserver = NavigatorObserver();

  static void section(DrawerSection section) {}
  static void screen(String name) {}
  static void relog() {}

  Future<void> logCheckIn() async {}
  Future<void> logCheckOut() async {}
  Future<void> logFirstLoginEver() async {}
}

class _ChatStats {
  Future<void> count(String key, [int by = 1]) async {}
  Future<void> push(String result) async {}
  Future<void> reply(String result, {required bool main}) async {}
  Future<void> flush() async {}
  Future<void> report(Object prefs, {required bool remote, required bool loaded, bool hideWeb = false}) async {}
  void unknownRoom(String id) {}
  void notificationOpen(String source, String target) {}
  void health(Map data) {}
  String roomKind(String roomId) => '';
}
